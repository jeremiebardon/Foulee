# Committed on purpose: non-secret values only. EXPO_PUBLIC_* are inlined in the app in plain text.
# Expo CLI loads this file in production mode (expo export, release builds, EAS Update). Secrets live in EAS.
EXPO_PUBLIC_APP_VARIANT=production
# The BFF on Fly.io (app name in apps/bff/fly.toml). No secret: the access token is entered in Settings.
EXPO_PUBLIC_BFF_URL=https://foulee-bff.fly.dev
