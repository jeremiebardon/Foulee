# Committed on purpose: non-secret values only. EXPO_PUBLIC_* are inlined in the app in plain text.
# Expo CLI loads this file in development mode (expo start, debug builds). Secrets live in EAS.
EXPO_PUBLIC_APP_VARIANT=development

# The local BFF (`pnpm --filter bff dev`, port 3000). The iOS simulator reaches the computer as
# localhost; an Android emulator needs http://10.0.2.2:3000 and a phone the computer's LAN address.
# Override it in a git-ignored .env.development.local rather than editing this file.
EXPO_PUBLIC_BFF_URL=http://localhost:3000
