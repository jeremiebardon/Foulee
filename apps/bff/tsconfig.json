{
  "extends": "@foulee/tsconfig/base.json",
  "compilerOptions": {
    "target": "ES2023",
    "lib": ["ES2023"],
    "module": "nodenext",
    "isolatedModules": true,
    "experimentalDecorators": true,
    "emitDecoratorMetadata": true,
    "outDir": "dist",
    "rootDir": ".",
    "types": ["node", "jest"],
    "sourceMap": true,
    "noEmit": true
  },
  "include": ["src", "test", "jest.config.js"]
}
