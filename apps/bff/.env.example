# Copy to .env.local (git-ignored) for local development: cp .env.example .env.local
# In production these are Fly secrets (`fly secrets set ...`), never a file.

# Your Personal API Key: create one in Garmin Connect, under Settings -> "Personal API token"
# (https://connect.garmin.com/app/settings/personalApiToken).
# Expires in 30 days to one year; once it does, GET /v1/activities answers garmin_access_expired.
GARMIN_PERSONAL_API_KEY=replace-with-your-garmin-personal-api-key

# Shared secret the app sends as `Authorization: Bearer <token>`.
# Generate one: node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
# At least 32 characters. The placeholder below is rejected at boot: replace it.
BFF_ACCESS_TOKEN=replace-with-a-long-random-string

# Optional. Default 3000.
# PORT=3000
